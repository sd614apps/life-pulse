{
  "name": "SessionLog",
  "type": "object",
  "properties": {
    "device_type": {
      "type": "string",
      "title": "Device Type"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "ip_address": {
      "type": "string",
      "title": "Ip Address"
    },
    "last_active_at": {
      "type": "string",
      "title": "Last Active At",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    },
    "session_type": {
      "type": "string",
      "title": "Session Type"
    }
  },
  "required": [
    "device_type",
    "location",
    "last_active_at",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
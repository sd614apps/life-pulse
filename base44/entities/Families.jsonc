{
  "name": "Families",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Family Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "family_id": {
      "type": "string",
      "title": "Family Id"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
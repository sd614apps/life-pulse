{
  "name": "HealthLog",
  "type": "object",
  "properties": {
    "member_name": {
      "type": "string",
      "title": "Member Name"
    },
    "metric_type": {
      "type": "string",
      "title": "Metric Type",
      "enum": [
        "blood_pressure",
        "heart_rate",
        "steps",
        "blood_sugar"
      ],
      "default": "heart_rate"
    },
    "value": {
      "type": "number",
      "title": "Value"
    },
    "secondary_value": {
      "type": "number",
      "title": "Secondary Value",
      "default": 0
    },
    "unit": {
      "type": "string",
      "title": "Unit"
    },
    "logged_at": {
      "type": "string",
      "title": "Logged At",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "logged",
        "upcoming"
      ],
      "default": "logged"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "family_id": {
      "type": "string",
      "title": "Family Id"
    }
  },
  "required": [
    "member_name",
    "metric_type",
    "value",
    "logged_at",
    "status"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}